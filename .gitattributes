# Batch files must reach Windows with CRLF endings.  cmd.exe can mis-parse a
# label - and so fail a "goto" - in a file whose lines end in LF alone, which
# would break install.cmd's error path on the machines it exists for.
*.cmd text eol=crlf
*.bat text eol=crlf

# PowerShell is content either way, but a file a Windows user may open in
# Notepad is easier to read with the endings that platform expects.
*.ps1 text eol=crlf

# The shell scripts and everything else keep LF.
*.sh text eol=lf
